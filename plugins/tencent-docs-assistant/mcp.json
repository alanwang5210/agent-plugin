{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "tencent-docs": {
      "type": "streamable-http",
      "url": "https://docs.qq.com/openapi/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {"mode": "dcr"},
            "defaultScopes": ["docs:read", "docs:write", "docs:manage"]
          }
        }
      }
    }
  }
}
